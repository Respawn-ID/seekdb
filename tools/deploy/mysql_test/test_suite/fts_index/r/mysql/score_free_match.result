drop database if exists fts_score_free;
create database fts_score_free;
use fts_score_free;
create table docs (
id bigint auto_increment primary key,
category int not null,
title varchar(256) not null,
content text not null,
title_en varchar(256) not null,
content_en text not null
) default charset = utf8mb4;
insert into docs (category, title, content, title_en, content_en) values
(1, '数据库性能优化实践', '全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例。', 'Full-text search indexing benchmark', 'The quick brown fox jumps over the lazy dog.'),
(2, '全文索引分词器热路径分析', '在大量文档索引场景下，ik 分词需要频繁查词典和判断停用词。', 'Tokenization hot path optimization', 'Completed the annual security audit. No major vulnerabilities were found.'),
(3, 'OceanBase 稳定性的工程经验', 'OceanBase 是一款非常稳定的数据库，支持 ik、beng、space、ngram 等多种内置分词器。', 'Database audit and security review', 'Database performance optimization focuses on index build and IO reduction.'),
(4, '倒排索引与检索系统设计', '倒排索引是全文检索的核心数据结构，分词质量直接影响召回率。', 'Inverted index build performance', 'Bulk loading documents triggers repeated tokenizer execution.'),
(5, '中文分词 ik 词典加载机制', '中华人民共和国人民大会堂是著名地标，本文用于测试中文分词差异。', 'English tokenizer beng parser test', 'English beng parser tokenization is used as a baseline.'),
(6, '搜索引擎召回率调优笔记', '性能优化需要结合 profile 数据定位热点，tokenizer 和 database 都很重要。', 'Query latency under heavy load', 'database performance audit under heavy load'),
(7, 'SQL 执行计划与索引选择', '与全文无关的普通文本。', 'Document retrieval relevance scoring', 'nothing relevant here'),
(8, '日志系统内存池化设计', '倒排索引 tokenizer 全文索引 分词器', 'Bulk insert throughput measurement', 'database database database');
alter table docs add fulltext index fti_all_ik(title, content) with parser ik;
alter table docs add fulltext index fti_content_ik(content) with parser ik;
alter table docs add fulltext index fti_en_beng(title_en, content_en) with parser beng;
result_format: 4
explain select count(*) from docs where match(title, content) against('全文索引 分词器');
Query Plan
=================================================================
|ID|OPERATOR             |NAME            |EST.ROWS|EST.TIME(us)|
-----------------------------------------------------------------
|0 |SCALAR GROUP BY      |                |1       |342         |
|1 |└─TEXT RETRIEVAL SCAN|docs(fti_all_ik)|7       |342         |
=================================================================
Outputs & filters:
-------------------------------------
  0 - output([T_FUN_COUNT(*)]), filter(nil), rowset=16
      group(nil), agg_func([T_FUN_COUNT(*)])
  1 - output(nil), filter(nil), rowset=16
      access(nil), partitions(p0)
      is_index_back=false, is_global_index=false, 
      calc_relevance=false, match_expr(MATCH(docs.title, docs.content) AGAINST('全文索引 分词器')), 
      pushdown_match_filter(MATCH(docs.title, docs.content) AGAINST('全文索引 分词器'))
select count(*) from docs where match(title, content) against('全文索引 分词器');
